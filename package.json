{
  "name": "gan-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssr": "ng run gan-front:build && ng run gan-front:server",
    "serve:ssr": "npm run build:ssr && node dist/gan-front/server/main.js",
    "dev:ssr": "npm run serve:ssr",
    "mock:api": "json-server --watch db.json --port 3001",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:unit && npm run test:e2e",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:report": "playwright show-report",
    "test:with-mock": "concurrently \"npm run start\" \"npm run test:e2e:chrome\"",
    "test:e2e:with-mock": "npm run test:with-mock",
    "lint": "ng build --configuration production",
    "lhci": "npx --yes @lhci/cli@0.14.0 autorun"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.1",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.1",
    "@angular/cli": "^18.2.1",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^8.2.2",
    "jasmine-core": "~5.2.0",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "ts-node": "^10.9.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-edge-launcher": "^0.4.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "typescript": "~5.5.2"
  }
}
