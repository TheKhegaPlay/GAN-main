{
  "testRunner": "jasmine",
  "testFramework": "jasmine",
  "mutate": [
    "src/app/services/auth.service.ts",
    "src/app/dynamic-forms/dynamic-form.service.ts",
    "src/app/pages/dashboard.component.ts"
  ],
  "reporters": ["html", "json"],
  "coverageAnalysis": "perTest",
  "plugins": [
    {
      "name": "@stryker-mutator/typescript-checker",
      "options": {
        "checker": {
          "args": ["--strict"]
        }
      }
    }
  ],
  "concurrency": 4,
  "logLevel": "info"
}
